#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: TeddyCloud
# Runs TeddyCloud
# ==============================================================================

bashio::log.info "Starting TeddyCloud..."

# Create the certs and config directories on every start (as upstream does),
# so the symlinks in /teddycloud never dangle on existing installs.
mkdir -p /config/teddycloud/certs/server /config/teddycloud/certs/server_tb2 \
         /config/teddycloud/certs/client /config/teddycloud/config

# Create the data directories on every start, so directories added in newer
# versions (and the cache excluded from backups) exist on existing installs too.
mkdir -p /data/teddycloud/content /data/teddycloud/library /data/teddycloud/custom_img \
         /data/teddycloud/plugins /data/teddycloud/firmware /data/teddycloud/cache

cd /teddycloud || exit

exec /usr/local/bin/teddycloud
